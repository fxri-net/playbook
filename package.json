{
  "name": "@fxri/playbook",
  "version": "0.4.0",
  "private": true,
  "description": "面向 AI 协作的综合实践技能集：规范与流程沉淀为技能，按项目与语言组合，按需加载。",
  "license": "MIT",
  "author": {
    "name": "唐启云",
    "email": "tqy@fxri.net",
    "url": "https://fxri.net:444/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxri-net/playbook.git"
  },
  "bugs": {
    "url": "https://github.com/fxri-net/playbook/issues"
  },
  "homepage": "https://fxri-net.github.io/playbook/",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "catalog": "node scripts/gen-catalog.mjs",
    "catalog:check": "node scripts/gen-catalog.mjs --check",
    "verify": "node scripts/verify.mjs",
    "changeset": "node scripts/toolkit.mjs changelog",
    "changelog:version": "node scripts/toolkit.mjs changelog version && node scripts/sync-version.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "sync:changelog-doc": "node scripts/toolkit.mjs changelog doc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "agent-skills",
    "playbook",
    "engineering-standards",
    "skills",
    "fxri"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.34.4",
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
